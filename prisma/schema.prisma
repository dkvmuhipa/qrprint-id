generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Shop {
  id                  String                @id @default(cuid())
  shopCode            String                @unique
  shopCodeChangeCount Int                   @default(0)
  name                String
  ownerName           String                @default("Pemilik Toko")
  email               String                @unique
  phone               String
  address             String
  passwordHash        String
  plan                String                @default("DEMO")
  planStatus          String                @default("ACTIVE")
  planExpiresAt       DateTime?
  isTestShop          Boolean               @default(false)
  hasListenerAddon    Boolean               @default(false)
  hasPasFotoAddon     Boolean               @default(false)
  hasHoldPrintAddon   Boolean               @default(false)
  extraPrinterSlots   Int                   @default(0)
  bwPrice             Int                   @default(500)
  colorPrice          Int                   @default(1500)
  duplexDiscount      Int                   @default(10)
  photoPrice          Int                   @default(3000)
  f4ExtraPrice        Int                   @default(100)
  bindingLakbanPrice  Int                   @default(3000)
  bindingMikaPrice    Int                   @default(5000)
  bindingSpiralPrice  Int                   @default(10000)
  agentKey            String                @unique
  agentMachineHash    String?
  agentLastSeen       DateTime?
  agentPrinters       String                @default("[]")
  bwPrinter           String                @default("Default Printer")
  colorPrinter        String                @default("Default Printer")
  photoPrinter        String                @default("Default Printer")
  thermalPrinter      String                @default("")
  autoPrintReceipt    Boolean               @default(false)
  isOpenManual        Boolean               @default(true)
  openHour            String                @default("")
  closeHour           String                @default("")
  closedMessage       String                @default("")
  qrisName            String                @default("QRIS Toko")
  staticQrisString    String?
  staticQrisHash      String?
  midtransServerKey   String?
  midtransIsProd      Boolean               @default(false)
  referredByShopId    String?
  referralRewarded    Boolean               @default(false)
  referralCount       Int                   @default(0)
  logoDataUrl         String?
  city                String                @default("")
  tagline             String                @default("")
  mapsUrl             String                @default("")
  latitude            Float?
  longitude           Float?
  instagramHandle     String                @default("")
  showInDirectory     Boolean               @default(true)
  isFeaturedPartner   Boolean               @default(false)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  jobs                PrintJob[]
  invoices            SubscriptionInvoice[]
}

model PrintJob {
  id               String    @id @default(cuid())
  jobCode          String    @unique
  shopId           String?
  shop             Shop?     @relation(fields: [shopId], references: [id], onDelete: SetNull)
  shopNameSnapshot String?
  shopCodeSnapshot String?
  customerName     String    @default("Pelanggan")
  customerWhatsapp String?
  customerNotes    String?
  fileName        String
  storedFilePath  String?
  mimeType        String
  fileSize        Int
  pageCount       Int
  copies          Int       @default(1)
  colorMode       String    @default("BW")
  paperSize       String    @default("A4")
  duplex          Boolean   @default(false)
  pageRange       String    @default("ALL")
  bindingType     String    @default("NONE")
  bindingPrice    Int       @default(0)
  totalPrice      Int
  paymentMethod   String    @default("QRIS")
  paymentProvider String    @default("SIMULATION")
  paymentOrderId  String?   @unique
  qrisUrl         String?
  qrisString      String?
  paymentStatus    String    @default("PENDING")
  printStatus      String    @default("WAITING_PAYMENT")
  holdUntilArrival Boolean   @default(false)
  fileDeletedAt    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model SubscriptionInvoice {
  id               String    @id @default(cuid())
  invoiceCode      String    @unique
  shopId           String?
  shop             Shop?     @relation(fields: [shopId], references: [id], onDelete: SetNull)
  shopNameSnapshot String?
  shopCodeSnapshot String?
  plan             String
  amount          Int
  durationDays    Int?
  paymentProvider String    @default("SIMULATION")
  paymentOrderId  String?   @unique
  qrisUrl         String?
  qrisString      String?
  status          String    @default("PENDING")
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model DemoRequest {
  id        String   @id @default(cuid())
  name      String
  whatsapp  String
  shopName  String
  address   String
  email     String
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

model PlatformBroadcast {
  id        String   @id @default("global")
  active    Boolean  @default(false)
  level     String   @default("INFO")
  title     String   @default("")
  message   String   @default("")
  linkUrl   String   @default("")
  linkLabel String   @default("")
  updatedBy String   @default("")
  updatedAt DateTime @updatedAt
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String
  target     String   @default("")
  details    String   @default("")
  createdAt  DateTime @default(now())
}
